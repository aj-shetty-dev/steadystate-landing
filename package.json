{
  "name": "steady-state",
  "version": "0.1.0",
  "private": true,
  "description": "SteadyState — The intelligence layer for UAE gym operators.",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm --filter @steady-state/web build",
    "dev": "pnpm --filter @steady-state/web dev",
    "lint": "pnpm --filter @steady-state/web lint",
    "typecheck": "pnpm --filter @steady-state/web typecheck",
    "test": "pnpm --filter @steady-state/web test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "db:generate": "pnpm --filter @steady-state/web db:generate",
    "db:push": "pnpm --filter @steady-state/web db:push",
    "db:migrate": "pnpm --filter @steady-state/web db:migrate",
    "db:studio": "pnpm --filter @steady-state/web db:studio",
    "clean": "pnpm --filter @steady-state/web clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
