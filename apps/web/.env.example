# Supabase PostgreSQL — connection pooler (port 6543)
# IMPORTANT: If your local network blocks IPv6, add this /etc/hosts entry:
#   3.106.102.114 db.<your-project-ref>.supabase.co
DATABASE_URL=
# Direct URL (same as above for local dev; use direct IPv6 on Vercel)
DIRECT_URL=

# Clerk — get from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Stripe — optional in dev (defaults to mock mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# STRIPE_MODE=mock

# Twilio — optional in dev (defaults to mock mode)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# TWILIO_MODE=mock
