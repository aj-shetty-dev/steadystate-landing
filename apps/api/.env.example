# Node env
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Database
# Pooled connection (PgBouncer) — used by the app at runtime
DATABASE_URL="postgresql://steadystate:steadystate@localhost:5432/steady_state_dev?schema=public"
# Direct connection — required by prisma migrate (bypasses PgBouncer)
DIRECT_URL="postgresql://steadystate:steadystate@localhost:5432/steady_state_dev"

# Redis (BullMQ)
REDIS_URL="redis://localhost:6379"

# JWT secrets — replace with `openssl rand -base64 64` output in real envs
JWT_ACCESS_SECRET="dev-access-secret-change-me-please-32chars-minimum-xxxxxxxxxxxxxx"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me-please-32chars-minimum-xxxxxxxxxxxxx"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Twilio — mock mode never hits the network. Switch to `live` once you have real creds.
TWILIO_MODE="mock"
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your-auth-token"
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# CRM mode — `fake` uses in-memory fixtures (Phase 1–2). Switch to `live` once we have real creds.
CRM_MODE="fake"

# Door event webhook HMAC secret — required to verify incoming biometric/access pings.
DOOR_WEBHOOK_SECRET="change-me-door-secret-dev-only"

# Data residency hint — production must be me-south-1 (Bahrain). Other values log a warning.
DATA_REGION="me-south-1"

# Subscription billing provider — mock until we wire Stripe/Telr.
BILLING_PROVIDER_MODE="mock"

# Stripe — set STRIPE_MODE=live and supply real keys to enable checkout + portal.
STRIPE_MODE="mock"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_DEFAULT_CURRENCY="aed"
STRIPE_PRICE_STARTER="price_mock_starter"
STRIPE_PRICE_GROWTH="price_mock_growth"
STRIPE_PRICE_SCALE="price_mock_scale"

# Salary-synced billing — Dubai window defaults; override per tenant via the DB.
BILLING_DEFAULT_WINDOW_START=25
BILLING_DEFAULT_WINDOW_END=28
BILLING_DEFAULT_TIMEZONE="Asia/Dubai"
BILLING_JITTER_MINUTES=120
BILLING_CRON="0 6 * * *"

# CORS
CORS_ORIGIN="http://localhost:3000"
